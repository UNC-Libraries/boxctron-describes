# Application Configuration
APP_NAME=boxctron-describes
APP_VERSION=0.1.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
# ROOT_PATH=/boxctron-describes  # Uncomment if behind reverse proxy at subpath

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Google Gemini Configuration (optional)
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude Configuration (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LiteLLM Configuration
LITELLM_FULL_DESC_MODEL=azure/gpt-4o
# Set when MODEL is an Azure deployment name that differs from the canonical model name.
# Example: LITELLM_FULL_DESC_MODEL=azure/describes, LITELLM_FULL_DESC_BASE_MODEL=gpt-5.6-terra
LITELLM_FULL_DESC_BASE_MODEL=
LITELLM_FULL_DESC_TEMPERATURE=0.7
LITELLM_FULL_DESC_MAX_TOKENS=1000
LITELLM_FULL_DESC_REASONING_EFFORT=low
LITELLM_NUM_RETRIES=3
LITELLM_DROP_PARAMS=true

# Transcript-quality pass (optional — triggered when text is SIGNIFICANT and PARTIALLY_CLEAR/DIFFICULT/ILLEGIBLE)
LITELLM_TRANSCRIBE_MODEL=gemini/gemini-2.5-pro
LITELLM_TRANSCRIBE_BASE_MODEL=
LITELLM_TRANSCRIBE_TEMPERATURE=0.3
# Includes the required description, alt text, safety form, and potentially long transcript.
LITELLM_TRANSCRIBE_MAX_TOKENS=3000
LITELLM_TRANSCRIBE_REASONING_EFFORT=
LITELLM_TRANSCRIBE_API_BASE=https://your-librechat-instance
LITELLM_TRANSCRIBE_API_KEY=your-proxy-key
LITELLM_TRANSCRIBE_TIMEOUT=30
# For Gemini 3 models, set per-image resolution. Valid values: low, medium, high, ultra_high.
LITELLM_TRANSCRIBE_MEDIA_RESOLUTION=high

LITELLM_REVIEW_MODEL=azure/gpt-4o
LITELLM_REVIEW_BASE_MODEL=
LITELLM_REVIEW_TEMPERATURE=0.7
LITELLM_REVIEW_MAX_TOKENS=1000
LITELLM_REVIEW_REASONING_EFFORT=low
REVIEW_SKIP_THRESHOLD=10

# Authentication
AUTH_ENABLED=False
API_KEYS=
AUTH_USERNAME=
AUTH_PASSWORD=

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760

# Image Processing Configuration
IMAGE_MAX_DIMENSION=1600

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Options: default, json
LOG_FORMAT=default

# Options: console, file, both
LOG_OUTPUT=console

# Required if LOG_OUTPUT is 'file' or 'both'
# LOG_FILE_PATH=/var/log/boxctron-describes/app.log

# Log rotation settings (used when LOG_OUTPUT includes 'file')
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
